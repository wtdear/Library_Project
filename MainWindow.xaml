<Window x:Class="Library_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Library_Project"
        mc:Ignorable="d"
        Title="Library" 
        Height="450" 
        Width="800"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border CornerRadius="20" 
            BorderThickness="4" 
            BorderBrush="#C5CDC3"
            Background="#8A9A8E"
            ClipToBounds="True">

        <Border.Effect>
            <DropShadowEffect BlurRadius="15" 
                              ShadowDepth="0" 
                              Opacity="0.3" 
                              Color="Black"/>
        </Border.Effect>

        <DockPanel>
            <Border DockPanel.Dock="Top" 
                    Background="#C5CDC3" 
                    CornerRadius="17,17,0,0"
                    Height="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" 
                                Orientation="Horizontal" 
                                Margin="15,0,0,0"
                                VerticalAlignment="Center">
                        <TextBlock Text="📕" 
                                   FontSize="20" 

                                   Foreground="#2C4A5C"/>
                        <TextBlock Text="Library Management" 
                                   FontSize="16" 
                                   FontFamily="Monocraft"
                                   Foreground="#2C4A5C"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.Column="1" MouseLeftButtonDown="Window_MouseLeftButtonDown"/>

                    <StackPanel Grid.Column="2" 
                                Orientation="Horizontal" 
                                Margin="0,0,15,0"
                                VerticalAlignment="Center">

                        <Button x:Name="MinimizeButton" 
                                Width="30" 
                                Height="30"
                                Content="-" 
                                FontSize="18"
                                FontWeight="Bold"
                                FontFamily="Monocraft"
                                Foreground="#2C4A5C"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MinimizeButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FF5555" 
                                                          Duration="0:0:0.1"
                                                          Storyboard.TargetProperty="Background.Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="Transparent" 
                                                          Duration="0:0:0.1"
                                                          Storyboard.TargetProperty="Background.Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>

                        <Button x:Name="CloseButton" 
                                Width="30" 
                                Height="30"
                                FontFamily="Monocraft"
                                Content="X" 
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="#2C4A5C"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.Triggers>
                                <EventTrigger RoutedEvent="Button.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#E81123" 
                                                          Duration="0:0:0.1"
                                                          Storyboard.TargetProperty="Background.Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Button.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="Transparent" 
                                                          Duration="0:0:0.1"
                                                          Storyboard.TargetProperty="Background.Color"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Button.Triggers>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Menu DockPanel.Dock="Top" 
                  MinHeight="22" 
                  Foreground="#2C4A5C"
                  Background="#C5CDC3" 
                  FontFamily="Monocraft" 
                  FontSize="14"
                  Margin="0,0,0,0">
                <MenuItem Header="☰ Books" Click="MenuItem_Click" Margin="12,0,0,0">
                    <MenuItem Header="Show list" Click="ShowListMenuItem_Click"/>
                    <MenuItem Header="Add" Click="AddMenuItem_Click"/>
                    <MenuItem Header="Delete" Click="DeleteMenuItem_Click"/>
                    <MenuItem Header="Edit" Click="EditMenuItem_Click"/>
                </MenuItem>
                <MenuItem Header="☰ About author" Click="Author_Click" Margin="12,0,0,0"/>
            </Menu>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="89*"/>
                    <ColumnDefinition Width="109*"/>
                </Grid.ColumnDefinitions>

                <ListBox Grid.Column="0"
                         Margin="12,39,12,23"
                         ItemsSource="{Binding Books}"
                         Background="#C5CDC3"
                         Foreground="#2C4A5C"
                         FontFamily="Monocraft"
                         FontSize="11"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Book}">
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="1" Margin="68,85,35,23">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25*"/>
                        <RowDefinition Height="33*"/>
                        <RowDefinition Height="204*"/>
                    </Grid.RowDefinitions>

                    <Button Margin="7,23,0,5" Click="ShowList_button"
                            Height="30" 
                            HorizontalAlignment="Left" 
                            Width="132"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Content="☰ All books"
                            FontFamily="Monocraft"
                            FontSize="18"
                            Foreground="#2C4A5C" Grid.RowSpan="2"/>

                    <Button Margin="172,0,0,5" Click="AddBook_button"
                            Height="30" 
                            VerticalAlignment="Bottom" 
                            HorizontalAlignment="Left" 
                            Width="125"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Content="+ Add book"
                            FontFamily="Monocraft"
                            FontSize="18"
                            Foreground="#2C4A5C" Grid.RowSpan="2"/>
                    <Button Margin="166,26,0,181" Click="Delete_button"
                        Height="30" 
                        HorizontalAlignment="Left" 
                        Width="172"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="- Delete book"
                        FontFamily="Monocraft"
                        FontSize="18"
                        Foreground="#2C4A5C" Grid.Row="1" Grid.RowSpan="2"/>
                    <Button Margin="-13,28,0,179" Click="EditMenuItem_Click"
                        Height="30" 
                        HorizontalAlignment="Left" 
                        Width="172"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="⚒️ Edit book&#xD;&#xA;"
                        FontFamily="Monocraft"
                        FontSize="18"
                        Foreground="#2C4A5C" Grid.Row="1" Grid.RowSpan="2"/>
                </Grid>

                <TextBlock Text="Library Management System" 
                           FontFamily="Monocraft"
                          Foreground="#2C4A5C"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          FontSize="18" Margin="0,39,0,0" Grid.Column="1" Height="20" Width="300"/>
            </Grid>
        </DockPanel>
    </Border>
</Window>